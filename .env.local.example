NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
DEV_BYPASS_AUTH=false
AUTH_MODE=local

# Required in Cloudflare Workers production. Must stay the single public app
# origin; do not derive redirect destinations from incoming Host headers.
APP_ORIGIN=https://invitation-event-calendar.amida-solutions.uk

# Required when AUTH_MODE=cloudflare (server-only values must never be exposed
# as NEXT_PUBLIC_* variables).
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-cloudflare-access-application-audience
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional cancellation email delivery (server-only; raw Resend API)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Calendar <calendar@example.com>
