{
  "name": "eventcalendar-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:local",
    "dev:local": "SUPABASE_TELEMETRY_DISABLED=1 npx --no-install supabase start && npm run env:local && next dev",
    "dev:remote": "npm run env:remote && next dev",
    "env:local": "SUPABASE_TELEMETRY_DISABLED=1 node scripts/supabase-env.mjs local",
    "env:remote": "SUPABASE_TELEMETRY_DISABLED=1 node scripts/supabase-env.mjs remote",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy:worker": "npm run build:worker && opennextjs-cloudflare deploy",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/*.test.ts",
    "start": "next start",
    "lint": "eslint",
    "supabase:status": "SUPABASE_TELEMETRY_DISABLED=1 npx --no-install supabase status"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.119.0"
  }
}
